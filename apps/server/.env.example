# 配置在服务端环境中；复制到工程根目录 .env 后 npm start 会读取。不要填写或提交真实密钥。
NODE_ENV=development
ALLOW_DEMO_AUTH=true
HOST=127.0.0.1
PORT=4188
# 可选绝对路径；不填时使用工程 data。
DATA_DIR=
DB_PATH=
QISHU_PYTHON=
# 厂家认证读取真实视频流；不填时从PATH寻找ffprobe。不要把本机绝对路径带到服务器。
QISHU_FFPROBE=
# 照片真实解码及去重需要ffmpeg；测试也用它生成视频样本。不填时从PATH寻找。
QISHU_FFMPEG=
# 真实小程序凭证仅保存在服务端环境；wx.login 不会自动授权手机号。
WX_APP_ID=
WX_APP_SECRET=
# 首次空库初始化管理员白名单手机号，仍需本人真实微信+手机号授权绑定。
BOOTSTRAP_ADMIN_PHONE=
# H5与API分域时填写允许的Origin，逗号分隔，禁止通配符。
ALLOWED_ORIGINS=
