.tabs{position:fixed;bottom:0;left:0;right:0;display:flex;background:#fff;border-top:1rpx solid #e1e8e3;padding:10rpx 8rpx calc(10rpx + env(safe-area-inset-bottom));z-index:100}.tab{width:25%;min-height:88rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:1em;color:#71807c;gap:3rpx}.active{color:#254f4d;font-weight:600}.symbol{font-size:37rpx;line-height:1}
