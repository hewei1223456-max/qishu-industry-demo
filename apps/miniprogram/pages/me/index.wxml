<view class="page" style="font-size:{{fontPx}}px"><view class="head"><view class="title">我的</view><text class="badge">{{supplier?'厂家端':'店主端'}}</text></view>
 <view class="panel"><view class="row"><view class="avatar">{{user?'七':'游'}}</view><view><view class="card-title">{{user?user.name:'游客 / 未登录'}}</view><view class="muted">{{user?(user.verified?'资质已审核':'未认证，查看认证进度'):'登录后管理自己的经营资料'}}</view></view></view><view class="notice" wx:if="{{user}}">{{user.demo?'开发演示账号，不代表正式微信认证。':'主体资料与公开权限分开管理。'}}</view><button wx:if="{{!user}}" class="primary full-btn" bindtap="open" data-page="login">登录与体验</button></view>
 <view class="notice" wx:if="{{needsTags}}" bindtap="open" data-page="tags">资质审核已通过，选择四至十个经营标签，完善你的推荐偏好 ›</view><view class="error" wx:if="{{error}}">{{error}}<button bindtap="load">重试</button></view>
 <view class="panel"><view class="link-row" bindtap="open" data-page="certify"><text>经营资料与认证</text><text class="arrow">›</text></view><view class="link-row" bindtap="open" data-page="tags"><text>经营偏好 四至十个标签</text><text class="arrow">›</text></view><view class="link-row" bindtap="open" data-page="knowledge"><text>我的私有知识库</text><text class="arrow">›</text></view><view class="link-row"><text>个性化推荐</text><switch checked="{{personalized}}" color="#254f4d" bindchange="preferences" disabled="{{!user}}"/></view><view class="link-row" wx:if="{{supplier}}" bindtap="backend"><text>厂家经营后台</text><text class="arrow">电脑端 ›</text></view></view>
 <view class="panel" wx:if="{{quota&amp;&amp;supplier}}"><view class="between"><view><view class="label">今日剩余主动联系</view><view class="stat">{{quota.remaining!==undefined?quota.remaining:'—'}}次</view></view><view class="muted">{{quota.plan.name||quota.plan||'当前版本'}}</view></view><view class="tiny">套餐、联系能力和额度由平台配置。权益在线下购买后开通；首发没有在线支付。</view></view>
 <view class="between"><view class="section-title">创作中心</view><button class="primary small-btn" bindtap="compose" data-kind="content">发布资讯</button></view>
 <view class="media-tools" wx:if="{{supplier}}"><button bindtap="compose" data-kind="product">发布货源</button><button bindtap="compose" data-kind="fair">发布订货会</button></view>
 <view class="panel"><view class="row"><view class="chip {{profileTab==='creator'?'active':''}}" data-tab="creator" bindtap="switchTab">我的内容</view><view class="chip {{profileTab==='leads'?'active':''}}" data-tab="leads" bindtap="switchTab">联系与回访</view></view>
 <block wx:if="{{profileTab==='creator'}}"><view class="list-item" wx:for="{{items}}" wx:key="id"><view class="card-title">{{item.title}}</view><view class="between"><text class="tiny">{{item.kind||'内容'}} · {{item.status||'已提交'}}</text><text class="muted" bindtap="removeContent" data-id="{{item.id}}">归档</text></view></view><view class="empty" wx:if="{{!items.length}}">发布的内容和草稿会出现在这里。</view></block>
 <block wx:else><view class="list-item" wx:for="{{leads}}" wx:key="id"><view class="card-title">{{item.buyerName||item.supplierName||item.buyerId||item.supplierId||'联系意向'}}</view><view class="muted">{{item.status||'待回访'}}</view><view class="tiny">{{item.note}}</view><button class="small-btn secondary" bindtap="followup" data-id="{{item.id}}">记录已回访</button></view><view class="empty" wx:if="{{!leads.length}}">还没有本账号的联系记录。</view></block></view>
 <button wx:if="{{user}}" class="full-btn" bindtap="logout">退出当前账号</button><view class="tiny" style="margin-top:28rpx">平台不承接商品交易。正式微信登录、已接入模型和设备验证状态分别确认。</view>
</view>
