<view class="page" style="font-size:{{fontPx}}px"><view class="back" bindtap="back">‹ 返回上一步</view><view class="loading" wx:if="{{loading}}">正在加载…</view><view class="error" wx:if="{{error}}">{{error}}<button bindtap="load">重试</button></view>
 <block wx:if="{{item}}"><text class="badge">{{item.category||'订货会'}} {{item.demoLabel}}</text><view class="title" style="margin-top:20rpx">{{item.title}}</view><view class="muted">{{item.author||item.companyName||item.organizer}}</view><image wx:if="{{item.imageUrl}}" class="image-preview" src="{{item.imageUrl}}" mode="aspectFit" bindtap="preview" binderror="imageError"/>
 <view class="panel" wx:if="{{kind==='product'}}"><view class="price">{{item.priceText}}</view><view class="metric-row"><text>产地</text><text>{{item.origin||'待补充'}}</text></view><view class="metric-row"><text>风格与品类</text><text>{{item.style}} · {{item.category}}</text></view><view class="metric-row"><text>起批量</text><text>{{item.moq||'—'}}件</text></view><view class="metric-row"><text>供货状态</text><text>{{item.status||'待补充'}}</text></view><view class="metric-row"><text>交期</text><text>{{item.delivery||'联系时核对'}}</text></view><view class="tiny">价格、现货与交期请在联系时再次确认。平台不承接订货交易。</view></view>
 <view class="panel" wx:if="{{kind==='fair'}}"><view class="metric-row"><text>地点</text><text>{{item.location||item.city||'待补充'}}</text></view><view class="metric-row"><text>日期</text><text>{{item.date||'待公告'}}</text></view><view class="notice">仅记录参加意向，不收款、不生成商品订单。</view></view>
 <view class="panel" wx:if="{{kind==='buyer'}}"><view class="metric-row"><text>城市与风格</text><text>{{item.city}} · {{item.style}}</text></view><view class="metric-row"><text>门店面积</text><text>{{item.area}}㎡</text></view><view class="metric-row"><text>客群与价带</text><text>{{item.customerAge}} · {{item.priceBand}}</text></view><view class="tiny">仅展示公开经营资料，不展示私有诊断或证照。</view></view>
 <view class="panel line-text">{{item.body||item.description||item.summary||'暂无补充说明'}}</view><view class="tiny" wx:if="{{item.source}}">来源：{{item.source}}</view>
 <block wx:if="{{kind==='product'||kind==='buyer'}}"><button class="primary full-btn" loading="{{leadBusy}}" bindtap="contact">{{kind==='buyer'?'向这家店主动联系':'联系厂家'}}</button><view class="notice" wx:if="{{contactResult}}">{{contactResult}}</view><view class="panel" wx:for="{{contactChannels}}" wx:key="type"><view class="field-label">{{item.label}}</view><view wx:if="{{item.type!=='qrcode'}}" class="line-text">{{item.value}}</view><button class="secondary full-btn" bindtap="useContact" data-index="{{index}}">{{item.type==='qrcode'?'查看联系二维码':'复制'+item.label}}</button></view></block>
 <button wx:if="{{kind==='fair'}}" class="primary full-btn" bindtap="interest">登记参加意向</button>
 </block></view>
