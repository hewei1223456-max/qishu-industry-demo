<view class="page" style="font-size:{{fontPx}}px"><view class="back" bindtap="back">‹ 返回，草稿请先保存</view><view class="title">创作与发布</view><view class="subtitle">支持文字、图片、视频及音频资料</view>
 <view class="row" style="margin-top:28rpx"><view class="chip {{kind==='content'?'active':''}}" bindtap="changeKind" data-kind="content">资讯 / 经验</view><view wx:if="{{supplier}}" class="chip {{kind==='product'?'active':''}}" bindtap="changeKind" data-kind="product">货源</view><view wx:if="{{supplier}}" class="chip {{kind==='fair'?'active':''}}" bindtap="changeKind" data-kind="fair">订货会</view></view>
 <view class="notice">资料默认先保存为私有草稿或进入审核。填写价格、产地和起批量时，请提供可核对的信息。</view>
 <view class="panel"><view class="field"><text class="field-label">标题</text><input placeholder="清楚说明这次发布的内容" value="{{form.title}}" data-field="title" bindinput="input"/></view><view class="field"><text class="field-label">正文与条件</text><textarea maxlength="-1" placeholder="填写真实素材及适用条件" value="{{form.body}}" data-field="body" bindinput="input"/></view>
 <view class="field"><text class="field-label">分类</text><input value="{{form.category}}" data-field="category" bindinput="input"/></view>
 <block wx:if="{{kind==='product'}}"><view class="field"><text class="field-label">风格</text><input value="{{form.style}}" data-field="style" bindinput="input"/></view><view class="field"><text class="field-label">产地</text><input value="{{form.origin}}" data-field="origin" bindinput="input"/></view><view class="row"><view class="field" style="flex:1;min-width:200rpx"><text class="field-label">拿货单价 元</text><input type="digit" value="{{form.price}}" data-field="price" bindinput="input"/></view><view class="field" style="flex:1;min-width:200rpx"><text class="field-label">起批量 件</text><input type="number" value="{{form.moq}}" data-field="moq" bindinput="input"/></view></view><view class="field"><text class="field-label">供货状态</text><input placeholder="现货或预售" value="{{form.status}}" data-field="status" bindinput="input"/></view></block>
 <block wx:if="{{kind==='fair'}}"><view class="field"><text class="field-label">时间</text><input placeholder="正式日期；未确认请注明待定" value="{{form.date}}" data-field="date" bindinput="input"/></view><view class="field"><text class="field-label">地点</text><input value="{{form.location}}" data-field="location" bindinput="input"/></view></block>
 <view class="media-tools"><button bindtap="choose" data-kind="image">添加图片</button><button bindtap="choose" data-kind="video">添加视频</button><button bindtap="choose" data-kind="audio">音频 / 文件</button></view>
 <view class="list-item" wx:for="{{files}}" wx:key="id"><view class="between"><text class="tiny">{{item.name||item.id}}</text><text class="muted" bindtap="removeFile" data-index="{{index}}">移除</text></view><image wx:if="{{item.kind==='image'}}" src="{{item.localPath}}" class="image-preview" mode="aspectFit"/></view>
 <button class="secondary full-btn" bindtap="organize" loading="{{busy}}" disabled="{{busy}}">用已配置AI整理资料</button><view class="tiny" wx:if="{{job}}">任务状态：{{job.status}}</view>
 <view class="actions"><button data-status="draft" bindtap="save" disabled="{{busy}}">保存草稿</button><button class="primary" data-status="pending" bindtap="save" loading="{{busy}}" disabled="{{busy}}">提交审核</button></view>
 </view><view class="error" wx:if="{{error}}">{{error}}</view><view class="notice" wx:if="{{notice}}">{{notice}}</view></view>
