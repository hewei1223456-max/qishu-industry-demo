<view class="page {{large?'large':''}}" style="font-size:{{fontPx}}px">
 <block wx:if="{{supplier}}">
  <view class="head"><view><view class="title">找客户</view><view class="subtitle">按拿货条件，找到适合的门店</view></view></view>
  <view class="panel" wx:if="{{quota}}"><view class="between"><view><view class="label">今日剩余主动联系</view><view class="stat">{{quota.remaining!==undefined?quota.remaining:'—'}} 次</view></view><view class="muted">{{quota.plan.name||quota.plan||'当前权益'}}</view></view><view class="tiny">免费及付费额度均由平台后台配置。权益首发在线下购买后开通。</view></view>
  <view class="panel"><input placeholder="搜索店主、店铺或拿货需求" value="{{query}}" data-field="query" bindinput="input" bindconfirm="loadBuyers"/><view class="row" style="margin-top:16rpx"><input style="flex:1;min-width:0" placeholder="城市" value="{{city}}" data-field="city" bindinput="input"/><input style="flex:1;min-width:0" placeholder="经营风格" value="{{style}}" data-field="style" bindinput="input"/></view><button class="secondary full-btn" bindtap="loadBuyers">筛选客户</button></view>
  <view class="error" wx:if="{{error}}">{{error}}<button class="small-btn" bindtap="loadBuyers">重试</button></view><view class="notice" wx:if="{{contactMessage}}">{{contactMessage}}</view><view class="panel" wx:for="{{contactChannels}}" wx:key="type"><view class="field-label">{{item.label}}</view><view wx:if="{{item.type!=='qrcode'}}">{{item.value}}</view><button class="secondary full-btn" bindtap="useContact" data-index="{{index}}">{{item.type==='qrcode'?'查看联系二维码':'复制'+item.label}}</button></view><view class="loading" wx:if="{{loading}}">正在匹配门店…</view>
  <view class="panel" wx:for="{{buyers}}" wx:key="id"><view bindtap="openBuyer" data-id="{{item.id}}"><view class="between"><view><view class="card-title">{{item.shop||item.name}}</view><view class="muted">{{item.name}} · {{item.city}}</view></view><text class="badge">公开经营资料</text></view><view class="divider"></view><view class="card-title">{{item.need}}</view><view class="muted">{{item.style}} · {{item.area}}㎡ · {{item.priceBand}}</view></view><view class="actions"><button class="secondary small-btn" bindtap="openBuyer" data-id="{{item.id}}">查看需求</button><button class="primary small-btn" bindtap="contactBuyer" data-id="{{item.id}}">主动联系</button></view></view>
  <view class="empty" wx:if="{{!loading&amp;&amp;!error&amp;&amp;!buyers.length}}">暂未找到符合条件的店主。</view><button bindtap="profile">查看权益与回访</button>
 </block>
 <block wx:else>
  <view class="head"><view><view class="title">店铺诊断</view><view class="subtitle">结合经营资料，找到下一步动作</view></view></view>
  <view class="row"><view class="chip {{mode==='diagnosis'?'active':''}}" bindtap="setMode" data-mode="diagnosis">填写资料诊断</view><view class="chip {{mode==='chat'?'active':''}}" bindtap="setMode" data-mode="chat">知识库咨询</view></view>
  <view class="notice">报告与原始资料默认私有。AI渠道未配置时将明确提示，不生成虚假的AI分析。</view>
  <view class="panel" wx:if="{{mode==='diagnosis'}}">
   <view class="field"><text class="field-label">城市与店型</text><input placeholder="如杭州社区女装店" value="{{form.city}}" data-field="city" bindinput="formInput"/></view>
   <view class="row"><view class="field" style="flex:1;min-width:200rpx"><text class="field-label">面积 ㎡</text><input type="digit" placeholder="按实际填写" value="{{form.area}}" data-field="area" bindinput="formInput"/></view><view class="field" style="flex:1;min-width:200rpx"><text class="field-label">经营时长 年</text><input type="digit" placeholder="按实际填写" value="{{form.years}}" data-field="years" bindinput="formInput"/></view></view>
   <view class="field"><text class="field-label">风格与客群</text><input placeholder="如韩系、25—35岁" value="{{form.style}}" data-field="style" bindinput="formInput"/></view>
   <view class="field"><text class="field-label">零售价带或客单</text><input placeholder="请注明口径与统计周期" value="{{form.priceBand}}" data-field="priceBand" bindinput="formInput"/></view>
   <view class="field"><text class="field-label">希望解决的问题</text><textarea maxlength="-1" placeholder="说清现象、已经尝试的动作及限制条件" value="{{form.question}}" data-field="question" bindinput="formInput"/></view>
   <button class="primary full-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="submitDiagnosis">提交诊断任务</button>
  </view>
  <view wx:else class="panel"><view wx:for="{{messages}}" wx:key="index" class="message {{item.role==='user'?'message-user':'message-ai'}}"><view class="tiny">{{item.role==='user'?'我的问题':'知识库回答'}}</view><view class="line-text">{{item.text}}</view></view><textarea maxlength="-1" placeholder="输入经营问题，可附图片、语音或视频资料" value="{{message}}" data-field="message" bindinput="input"/><view class="row" style="margin-top:20rpx"><view wx:for="{{taskOptions}}" wx:key="task" class="chip {{outputTask===item.task?'active':''}}" bindtap="chooseOutput" data-task="{{item.task}}">{{item.title}}</view></view><button class="primary full-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="sendMessage">提交本次任务</button><view class="tiny">仅使用平台已启用的模型渠道，未接入的能力会明确提示。</view></view>
  <view class="panel"><view class="card-title">补充本次资料</view><view class="media-tools"><button data-kind="image" bindtap="chooseMedia">图片</button><button data-kind="video" bindtap="chooseMedia">视频</button><button data-kind="audio" bindtap="chooseMedia">音频或文件</button><button bindtap="record">{{recording?'结束录音':'录制语音'}}</button></view><view class="tiny" wx:if="{{media}}">已上传：{{media.name||media.id}}</view><view class="media-tools" wx:if="{{media}}"><button data-task="ocr" bindtap="mediaTask">识别文字</button><button data-task="asr" bindtap="mediaTask">语音转写</button></view><view class="muted" bindtap="knowledge">管理我的私有知识库 ›</view></view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <view class="panel" wx:if="{{job}}"><view class="between"><text class="card-title">{{mode==='chat'?'任务状态':'诊断任务'}}</text><text class="badge">{{job.status}}</text></view><view class="line-text" style="margin-top:22rpx">{{jobResult||'任务处理中，完成后会显示结果。'}}</view><image wx:if="{{outputUrl&amp;&amp;outputType==='image'}}" src="{{outputUrl}}" class="image-preview" mode="aspectFit"/><video wx:if="{{outputUrl&amp;&amp;outputType==='video'}}" src="{{outputUrl}}" controls="{{true}}" style="width:100%;margin-top:24rpx"/><button wx:if="{{outputUrl&amp;&amp;(outputType==='audio'||outputType==='tts')}}" class="secondary full-btn" bindtap="playAudio">播放生成语音</button></view>
 </block>
</view>
